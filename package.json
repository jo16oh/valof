{
  "name": "valof",
  "version": "0.12.0",
  "description": "Branded, immutable domain types for TypeScript: a constructor and a companion per type, kept as plain data. Starts from 965 B gzipped.",
  "keywords": [
    "branded-types",
    "ddd",
    "deep-readonly",
    "domain-modeling",
    "immutable",
    "nominal-typing",
    "parse-dont-validate",
    "typescript",
    "value-object"
  ],
  "homepage": "https://github.com/jo16oh/valof#readme",
  "bugs": {
    "url": "https://github.com/jo16oh/valof/issues"
  },
  "license": "MIT",
  "author": "Joichiro Hayashi <jo16oh@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jo16oh/valof.git"
  },
  "bin": {
    "valof-lint": "./dist/lint-cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#valof": "valof-pinned-for-scripts"
  },
  "exports": {
    ".": "./dist/index.js",
    "./internal/*": "./dist/*.js",
    "./eslint-plugin": "./dist/eslint-plugin.mjs",
    "./lint": "./dist/lint.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack && tsc -p tsconfig.build.json",
    "docs:build": "mdbook build docs",
    "docs:serve": "mdbook serve docs",
    "test": "vp test",
    "check": "vp check",
    "bundle-size": "node scripts/bundle-size/index.ts",
    "replace-bundle-size-claims": "node scripts/replace-bundle-size-claims.ts",
    "ts-compatibility": "node scripts/ts-compatibility/index.ts",
    "type-perf": "node scripts/type-perf/index.ts",
    "prepublishOnly": "vp run build",
    "prepare": "vp config && vp fmt AGENTS.md && node scripts/pin-valof/index.ts",
    "pin-valof": "node scripts/pin-valof/index.ts",
    "bump-version": "scripts/bump-version.sh"
  },
  "devDependencies": {
    "@praha/byethrow": "^0.13.0",
    "@praha/error-factory": "^1.4.1",
    "@types/node": "^26.5.0",
    "bumpp": "^11.1.0",
    "eslint": "^10.10.0",
    "handlebars": "^4.7.9",
    "mdast-util-from-markdown": "^2.0.3",
    "oxc-parser": "^0.148.0",
    "oxlint": "1.82.0",
    "shiki": "^4.4.3",
    "twoslash": "^0.3.9",
    "typescript": "^7.0.2",
    "typescript-5": "npm:typescript@^5.9.3",
    "typescript-6": "npm:typescript@^6.0.3",
    "valof-pinned-for-scripts": "link:node_modules/.valof-pinned-for-scripts",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "oxc-parser": ">=0.148"
  },
  "peerDependenciesMeta": {
    "oxc-parser": {
      "optional": true
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.25.0",
      "onFail": "download"
    }
  },
  "valof-pinned-for-scripts-commit": "8d32b2ae3ab76618b3c577cc19b25da177c4242f"
}
