{
  "name": "valof",
  "version": "0.4.0",
  "description": "Value-object helpers for TypeScript: branded types, a constructor and a companion, kept as plain data. Around 1 kB gzipped.",
  "keywords": [
    "branded-types",
    "ddd",
    "immutable",
    "nominal-typing",
    "typescript",
    "value-object"
  ],
  "homepage": "https://github.com/jo16oh/valof#readme",
  "bugs": {
    "url": "https://github.com/jo16oh/valof/issues"
  },
  "license": "MIT",
  "author": "Joichiro Hayashi <jo16oh@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jo16oh/valof.git"
  },
  "bin": {
    "valof-lint": "./dist/lint-cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./eslint-plugin": "./dist/eslint-plugin.mjs",
    "./lint": "./dist/lint.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "size": "node scripts/size.ts",
    "ts-compatibility": "node scripts/ts-compatibility/index.ts",
    "prepublishOnly": "vp run build",
    "prepare": "vp config && vp fmt AGENTS.md",
    "bump-version": "git branch --show-current | grep -qxv main || { echo 'run this on a branch, not main'; exit 1; }; bumpp --no-tag",
    "push-tag": "git branch --show-current | grep -qx main || { echo 'run this on main'; exit 1; }; git tag v$npm_package_version && git push origin v$npm_package_version"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "bumpp": "^11.1.0",
    "eslint": "^10.10.0",
    "oxc-parser": "^0.148.0",
    "oxlint": "1.77.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "oxc-parser": ">=0.148"
  },
  "peerDependenciesMeta": {
    "oxc-parser": {
      "optional": true
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.25.0",
      "onFail": "download"
    }
  }
}
