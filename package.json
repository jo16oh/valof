{
  "name": "valof",
  "version": "0.8.2",
  "description": "Value-object helpers for TypeScript: branded types, a constructor and a companion, kept as plain data. Starts from 852 B gzipped.",
  "keywords": [
    "branded-types",
    "ddd",
    "immutable",
    "nominal-typing",
    "typescript",
    "value-object"
  ],
  "homepage": "https://github.com/jo16oh/valof#readme",
  "bugs": {
    "url": "https://github.com/jo16oh/valof/issues"
  },
  "license": "MIT",
  "author": "Joichiro Hayashi <jo16oh@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jo16oh/valof.git"
  },
  "bin": {
    "valof-lint": "./dist/lint-cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./eslint-plugin": "./dist/eslint-plugin.mjs",
    "./experimental": "./dist/experimental.mjs",
    "./lint": "./dist/lint.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "docs:build": "mdbook build docs",
    "docs:serve": "mdbook serve docs",
    "test": "vp test",
    "check": "vp check",
    "bundle-size": "node scripts/bundle-size.ts",
    "replace-bundle-size-claims": "node scripts/replace-bundle-size-claims.ts",
    "ts-compatibility": "node scripts/ts-compatibility/index.ts",
    "type-perf": "node scripts/type-perf/index.ts",
    "prepublishOnly": "vp run build",
    "prepare": "vp config && vp fmt AGENTS.md",
    "bump-version": "scripts/bump-version.sh",
    "push-tag": "git diff --quiet HEAD -- || { echo 'tracked files differ from HEAD; commit them before tagging'; exit 1; }; git switch main && git pull --ff-only && tag=v$(node -p \"require('./package.json').version\") && git tag $tag && git push origin $tag"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "bumpp": "^11.1.0",
    "eslint": "^10.10.0",
    "handlebars": "^4.7.9",
    "mdast-util-from-markdown": "^2.0.3",
    "oxc-parser": "^0.148.0",
    "oxlint": "1.82.0",
    "shiki": "^4.4.3",
    "twoslash": "^0.3.9",
    "typescript": "^7.0.2",
    "typescript-5": "npm:typescript@^5.9.3",
    "typescript-6": "npm:typescript@^6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "oxc-parser": ">=0.148"
  },
  "peerDependenciesMeta": {
    "oxc-parser": {
      "optional": true
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.25.0",
      "onFail": "download"
    }
  }
}
