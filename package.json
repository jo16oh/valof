{
  "name": "valof",
  "version": "0.0.0",
  "description": "Value-object helpers for TypeScript: branded types and companions, kept as plain data.",
  "keywords": [
    "branded-types",
    "ddd",
    "immutable",
    "nominal-typing",
    "typescript",
    "value-object"
  ],
  "homepage": "https://github.com/jo16oh/valof#readme",
  "bugs": {
    "url": "https://github.com/jo16oh/valof/issues"
  },
  "license": "MIT",
  "author": "Joichiro Hayashi <jo16oh@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jo16oh/valof.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "bumpp": "^11.1.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.25.0",
      "onFail": "download"
    }
  }
}
